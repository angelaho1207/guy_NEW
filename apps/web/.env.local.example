# Copy this file to `.env.local` in the same folder and fill in the values from
# your Supabase project, under Settings then API.
#
# `.env.local` is gitignored. This example file is not, so never put real
# values in it.

# https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The `anon` / `public` key, or the newer `sb_publishable_...` key.
# Safe in the browser. Row level security is what protects the data, not this.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The `service_role` / secret key.
#
# This BYPASSES every row level security policy in the schema. It exists only
# so a server-side worker can drain `public.push_outbox`. It must never appear
# in client code, in a `NEXT_PUBLIC_` variable, or in git.
SUPABASE_SERVICE_ROLE_KEY=
