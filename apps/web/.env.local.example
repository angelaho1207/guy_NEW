# Copy this file to `.env.local` in the same folder and fill in the values from
# your Supabase project, under Settings then API.
#
# `.env.local` is gitignored. This example file is not, so never put real
# values in it.

# Leave ALL of these blank to run against the throwaway demo database, which
# needs no account and no setup. Fill them in to run against your real project.

# Settings, then Database, then Connection string, then the *Transaction*
# pooler. It contains your database password, so it never goes in a
# NEXT_PUBLIC_ variable and never leaves this file.
#
# This is what the web pages read and write through. Row level security still
# applies: every query runs as the signed-in person, never as an admin.
SUPABASE_DB_URL=

# https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The `anon` / `public` key, or the newer `sb_publishable_...` key.
# Safe in the browser. Row level security is what protects the data, not this.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The `service_role` / secret key.
#
# This BYPASSES every row level security policy in the schema. It exists only
# so a server-side worker can drain `public.push_outbox`. It must never appear
# in client code, in a `NEXT_PUBLIC_` variable, or in git.
SUPABASE_SERVICE_ROLE_KEY=
